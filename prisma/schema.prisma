generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Registration {
  id              String   @id @default(cuid())
  nom             String
  postnom         String
  prenom          String
  sexe            String
  dateNaissance   String
  whatsapp        String
  email           String
  photoPath       String
  filiere         String
  filiereAutre    String?
  statut          String   @default("en_attente")
  commentaire     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}
